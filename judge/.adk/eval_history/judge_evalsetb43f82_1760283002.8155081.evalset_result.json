\u591a\u6578\u570b\u9ad8\u4e2d\u666e\u904d\u65e9\u65bc\u4e0a\u53488:30\u958b\u59cb\u4e0a\u8ab2\uff0c\u5c0e\u81f4\u9752\u5c11\u5e74\u666e\u904d\u7761\u7720\u4e0d\u8db3\u3002\u5c07\u4e0a\u8ab2\u6642\u9593\u5ef6\u81f3\u4e0a\u534810\u9ede\uff0c\u80fd\u8b93\u5b78\u751f\u7372\u5f97\u5145\u8db3\u7684\u7761\u7720\uff0c\u7b26\u5408\u5176\u81ea\u7136\u751f\u7406\u7bc0\u5f8b\uff0c\u6709\u52a9\u65bc\u8eab\u5fc3\u5065\u5eb7\u767c\u5c55\u3002\\n\\n**\u6709\u529b\u8b49\u64da\uff1a**\\n*   \u7f8e\u570b\u7761\u7720\u91ab\u5b78\u5b78\u6703\uff08American Academy of Sleep Medicine\uff09\u5efa\u8b7013\u81f318\u6b72\u9752\u5c11\u5e74\u6bcf\u5929\u61c9\u77618\u81f310\u5c0f\u6642\u3002\\n*   \u7814\u7a76\u986f\u793a\uff0c\u5ef6\u5f8c\u4e0a\u8ab2\u6642\u9593\u80fd\u986f\u8457\u589e\u52a0\u9752\u5c11\u5e74\u7684\u7761\u7720\u6642\u6578\uff0c\u5373\u4f7f\u50c5\u5ef6\u5f8c30\u5206\u9418\uff0c\u7761\u7720\u6642\u9577\u4e5f\u80fd\u589e\u52a0\u3002\u4f8b\u5982\uff0c\u897f\u96c5\u5716\u4e00\u9805\u7814\u7a76\u767c\u73fe\uff0c\u5c07\u4e0a\u8ab2\u6642\u9593\u5ef6\u5f8c\u5f8c\uff0c\u5b78\u751f\u6bcf\u665a\u5e73\u5747\u589e\u52a034\u5206\u9418\u7684\u7761\u7720\u6642\u9593\u3002\\n\\n**\u8ad6\u9ede\u4e8c\uff1a\u63d0\u5347\u5b78\u696d\u8868\u73fe\u8207\u5b78\u7fd2\u6548\u7387**\\n\u5145\u8db3\u7684\u7761\u7720\u5c0d\u65bc\u9752\u5c11\u5e74\u7684\u8a8d\u77e5\u529f\u80fd\u3001\u5c08\u6ce8\u529b\u3001\u8a18\u61b6\u529b\u548c\u89e3\u6c7a\u554f\u984c\u80fd\u529b\u81f3\u95dc\u91cd\u8981\u3002\u7576\u5b78\u751f\u7372\u5f97\u8db3\u5920\u7684\u4f11\u606f\u6642\uff0c\u4ed6\u5011\u5728\u8ab2\u5802\u4e0a\u6703\u66f4\u52a0\u5c08\u6ce8\uff0c\u6e1b\u5c11\u6253\u778c\u7761\u7684\u60c5\u6cc1\uff0c\u9032\u800c\u63d0\u9ad8\u5b78\u7fd2\u6548\u7387\u548c\u5b78\u696d\u6210\u7e3e\u3002\\n\\n**\u6709\u529b\u8b49\u64da\uff1a**\\n*   \u591a\u9805\u7814\u7a76\u6307\u51fa\uff0c\u5ef6\u5f8c\u4e0a\u8ab2\u6642\u9593\u8207\u5b78\u751f\u66f4\u9ad8\u7684\u51fa\u52e4\u7387\u3001\u66f4\u5c11\u7684\u9072\u5230\u3001\u8ab2\u5802\u4e0a\u66f4\u5c11\u6253\u778c\u7761\u4ee5\u53ca\u66f4\u597d\u7684\u6210\u7e3e\u76f8\u95dc\u3002\\n*   \u4e00\u9805\u7814\u7a76\u767c\u73fe\uff0c\u5c07\u4e0a\u8ab2\u6642\u9593\u5f9e\u4e0a\u53487:50\u63a8\u9072\u52308:45\uff0c\u5b78\u751f\u7684\u6210\u7e3e\u7565\u6709\u63d0\u9ad8\u3002\u53e6\u4e00\u9805\u7814\u7a76\u986f\u793a\uff0c\u5728\u5ef6\u9072\u4e0a\u8ab2\u6642\u9593\u5f8c\uff0c\u6838\u5fc3\u8ab2\u7a0b\u7684\u5e73\u5747\u6210\u7e3e\u63d0\u9ad8\u4e864.5%\u3002\\n\\n**\u8ad6\u9ede\u4e09\uff1a\u6539\u5584\u9752\u5c11\u5e74\u5fc3\u7406\u5065\u5eb7\u8207\u884c\u70ba**\\n\u7761\u7720\u4e0d\u8db3\u8207\u9752\u5c11\u5e74\u66f4\u9ad8\u7684\u58d3\u529b\u3001\u7126\u616e\u3001\u6182\u9b31\u3001\u60c5\u7dd2\u4e0d\u7a69\u548c\u885d\u52d5\u884c\u70ba\u98a8\u96aa\u76f8\u95dc\u3002\u5145\u8db3\u7684\u7761\u7720\u6709\u52a9\u65bc\u60c5\u7dd2\u8abf\u7bc0\uff0c\u964d\u4f4e\u5fc3\u7406\u5065\u5eb7\u554f\u984c\u7684\u767c\u751f\u7387\u3002\\n\\n**\u6709\u529b\u8b49\u64da\uff1a**\\n*   \u7814\u7a76\u8868\u660e\uff0c\u5ef6\u5f8c\u4e0a\u8ab2\u6642\u9593\u8207\u9752\u5c11\u5e74\u8ca0\u9762\u60c5\u7dd2\u6e1b\u5c11\u3001\u793e\u6703\u60c5\u7dd2\u5065\u5eb7\u6539\u5584\u6709\u95dc\u3002\\n*   \u6709\u7814\u7a76\u767c\u73fe\uff0c\u7761\u7720\u4e0d\u8db36\u5c0f\u6642\u7684\u9ad8\u4e2d\u751f\u8003\u616e\u6216\u5617\u8a66\u81ea\u6bba\u7684\u53ef\u80fd\u6027\u662f\u7761\u77208\u5c0f\u6642\u5b78\u751f\u7684\u4e09\u5230\u56db\u500d\u3002\u5145\u8db3\u7761\u7720\u80fd\u964d\u4f4e\u9752\u5c11\u5e74\u6182\u9b31\u3001\u7126\u616e\u548c\u7269\u8cea\u6feb\u7528\u554f\u984c\u7684\u98a8\u96aa\u3002\\n\\n**\u8ad6\u9ede\u56db\uff1a\u964d\u4f4e\u9752\u5c11\u5e74\u4ea4\u901a\u4e8b\u6545\u98a8\u96aa**\\n\u9752\u5c11\u5e74\u7761\u7720\u4e0d\u8db3\u6703\u5c0e\u81f4\u5224\u65b7\u529b\u53d7\u640d\u548c\u53cd\u61c9\u6642\u9593\u8b8a\u6162\uff0c\u9019\u5c0d\u958b\u8eca\u7684\u9752\u5c11\u5e74\u4f86\u8aaa\u5c24\u5176\u5371\u96aa\u3002\u5ef6\u5f8c\u4e0a\u8ab2\u6642\u9593\u80fd\u8b93\u9752\u5c11\u5e74\u5728\u958b\u8eca\u4e0a\u5b78\u6642\u66f4\u52a0\u6e05\u9192\u548c\u5c08\u6ce8\uff0c\u5f9e\u800c\u964d\u4f4e\u4ea4\u901a\u4e8b\u6545\u7684\u767c\u751f\u7387\u3002\\n\\n**\u6709\u529b\u8b49\u64da\uff1a**\\n*   \u591a\u9805\u7814\u7a76\u986f\u793a\uff0c\u5ef6\u5f8c\u4e0a\u8ab2\u6642\u9593\u8207\u9752\u5c11\u5e74\u99d5\u99db\u54e1\u8eca\u798d\u4e8b\u6545\u7387\u986f\u8457\u4e0b\u964d\u6709\u95dc\u3002\u4f8b\u5982\uff0c\u7dad\u5409\u5c3c\u4e9e\u5dde\u8cbb\u723e\u6cd5\u514b\u65af\u7e23\u5c07\u4e0a\u8ab2\u6642\u9593\u5ef6\u5f8c50\u5206\u9418\u5f8c\uff0c16\u81f318\u6b72\u6301\u7167\u99d5\u99db\u54e1\u7684\u4e8b\u6545\u7387\u5f9e\u6bcf\u5343\u540d\u99d5\u99db\u54e131.63\u4ef6\u964d\u81f329.59\u4ef6\u3002\"}]],[\"stop_checker\",[{\"video_metadata\":null,\"thought\":null,\"inline_data\":null,\"file_data\":null,\"thought_signature\":\"CqMDAdHtim8rzoB7uooy-vSNph85QrCeo4QZRhsfcE-hTnlI4A5uW6wW36gpwVVB84SoSh99yLwzy6OGKz6i2Dt9SrHU84cuV4EFTgiQpdzzciY48lA4PQwzStgmNzmtTp20SPSYJI7JXnF54DPrPquWA_-_D8vXroyGHiBsH0zBc4TmbnOYTCOScgRzH-f2ckMHv0BWjEYvBr2y75nE7SgSMqD0zMS9vCNefsrvSMYNnoEO5-jSIMJA_RrW1Nn-LiHN9ItyoeWBfoEVy586r97Rc0c6NJ4A4oPybkSB0a3t2J2qN-iHmYe8bfYrjUgW9XZP__q11HWrdbYPQCwUd7qSzn-Xv9fAhuOwccGW_TuWByXeR5TLFk7JPIyzeRd27dk7MrMYTT76T3r645aSyplemxppqxwZihWccu0Eq3B3g7fq4hhxfIp6IyLnEREjGFqmK9tm5IZaY2I2jKqSE_ium3kym29LDrnYnXdavNr7FwVXFb7MafhXVleYoshkKQe-NXG36AdmBJf3jtAob3QlMSJ0noXybGMyhXylP1Bp88-a5Ws=\",\"function_call\":null,\"code_execution_result\":null,\"executable_code\":null,\"function_response\":null,\"text\":\"continue\"}]],[\"moderator_decider\",[{\"video_metadata\":null,\"thought\":null,\"inline_data\":null,\"file_data\":null,\"thought_signature\":null,\"function_call\":null,\"code_execution_result\":null,\"executable_code\":null,\"function_response\":null,\"text\":\"{\\\"next_speaker\\\": \\\"Skeptic\\\", \\\"rationale\\\": \\\"Advocate\u5df2\u5b8c\u6210\u8ad6\u8ff0\uff0c\u63a5\u4e0b\u4f86\u8f2a\u5230Skeptic\u9673\u8ff0\u81ea\u5df1\u7684\u89c0\u9ede\uff0c\u9032\u5165\u7b2c\u4e00\u8f2a\u8ad6\u8ff0\u968e\u